# Application
NODE_ENV=development
APP_NAME=ACCESS Backend
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Interactive API documentation (Scalar)
# Leave empty to enable outside production and disable in production.
OPENAPI_ENABLED=
OPENAPI_PATH=/docs

# Browser access
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/access
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Authentication
# Replace both secrets with independent random values of at least 32 characters.
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-token-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-token-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=604800
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Optional Redis queue. Core workflows must work with this disabled.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Optional AI provider. Core workflows must work with this disabled.
AI_ENABLED=false
AI_PROVIDER=opencode
AI_CHAT_COMPLETIONS_URL=http://localhost:20128/v1/chat/completions
AI_MODEL=oc/deepseek-v4-flash-free
AI_API_KEY=
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=15000
AI_MAX_OUTPUT_TOKENS=10000
AI_TEMPERATURE=0.3
AI_GUIDELINES_PATH=src/modules/quick-responses/prompts/heat-guidelines.txt

# Optional SBERT embedding service. Used for semantic similarity storage/search support.
EMBEDDING_ENABLED=false
EMBEDDING_SERVICE_URL=https://fadq-access-embedding.hf.space/embed
EMBEDDING_BATCH_SERVICE_URL=https://fadq-access-embedding.hf.space/embed/batch
EMBEDDING_HEALTH_URL=https://fadq-access-embedding.hf.space/health
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_VERSION=2
EMBEDDING_BATCH_SIZE=16

# Optional semantic context search for quick response preview.
SEMANTIC_CONTEXT_ENABLED=true
SEMANTIC_MIN_RAW_SIMILARITY=0.50
SEMANTIC_MIN_SCORE=8.5
SEMANTIC_CATEGORY_BOOST=2.0
SEMANTIC_REFERENCE_SOURCE_TYPE_BOOST=0.5
SEMANTIC_RESOLVED_CASE_RECENCY_BOOST=0.3
SEMANTIC_REFERENCE_LIMIT=3
SEMANTIC_CASE_LIMIT=3
SEMANTIC_CANDIDATE_LIMIT=10

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REFERENCE_BUCKET=references_storage
SUPABASE_SIGNED_URL_EXPIRES=3600
REFERENCE_MAX_FILE_SIZE_MB=5
